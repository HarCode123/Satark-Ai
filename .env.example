# GEMINI_API_KEY: Server-side only Gemini AI API calls and Live WebSocket proxy.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# NEVER expose this key to client-side bundles or frontend routes.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port configuration (Defaults to 3000 if unset)
PORT=3000

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# MySQL Database Configuration
# When provided, MySQL is used as the authoritative persistence store.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=kateb_ai
DB_PORT=3306
